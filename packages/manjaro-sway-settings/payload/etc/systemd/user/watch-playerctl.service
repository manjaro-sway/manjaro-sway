[Unit]
Description=Playerctl waybar signal
PartOf=sway-session.target

[Service]
ExecStart=/bin/bash -c 'playerctl -a metadata --format "{{status}} {{title}}" --follow | while read line; do waybar-signal playerctl; waybar-signal idle; done'
Restart=on-failure
RestartSec=1

[Install]
WantedBy=sway-session.target
