[Unit]
Description=Autotiling for Sway
PartOf=sway-session.target
After=sway-session.target

[Service]
Type=simple
ExecStart=/bin/sh -c 'if [ -x "$(command -v autotiling)" ]; then exec autotiling; elif [ -x "$(command -v autotiling-rs)" ]; then exec autotiling-rs; fi'
Restart=on-failure

[Install]
WantedBy=sway-session.target
